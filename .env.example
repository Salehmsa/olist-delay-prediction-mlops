# Template only - copy to `.env` if you need to override a default.
# `.env` itself is gitignored (see .gitignore); this file is the committed
# record of which variables exist, so nothing about them silently
# disappears from the repo. docker-compose.yml substitutes these into the
# `register`/`api` services automatically if a `.env` file is present in
# the project root - no docker-compose.yml edit needed to change one.
#
# `docker compose up --build` works with ZERO setup and no `.env` file at
# all - every variable below has a safe default baked into
# docker-compose.yml, matching Task 3's "must run with one command on a
# clean machine" requirement. Only create a `.env` if you actually need a
# different value (e.g. pointing `api`/`register` at an external MLflow
# server instead of the bundled one).

# Where the `register` and `api` containers reach the MLflow tracking/
# registry server. Default (below) is the `mlflow` service's name on the
# docker-compose network - see docker-compose.yml's `mlflow` service and
# src/utils/config_loader.py's override logic. Not a secret (it only
# resolves inside the compose network) - still environment-driven rather
# than hardcoded, so swapping in a real external MLflow server later is a
# one-line change here, not a code change.
MLFLOW_TRACKING_URI=http://mlflow:5000
