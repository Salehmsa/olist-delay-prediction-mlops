# Section 8. Mirrors .gitignore's reasoning where it applies, plus
# Docker-specific exclusions. models/*.pkl is deliberately NOT excluded -
# docker-compose.yml's `register` service needs those files to log/
# register a model on first boot, same as running log_model.py locally.

# Version control / Docker meta-files - irrelevant inside the image
.git/
.gitignore
.dockerignore
Dockerfile
Dockerfile.mlflow
docker-compose.yml

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.ruff_cache/
.mypy_cache/

# Virtual environments - the image builds its own (Dockerfile's builder
# stage); a local .venv here would be the wrong Python/OS anyway.
.venv/
venv/
env/

# Secrets / environment - never bake these into an image layer.
.env
.env.*
!.env.example

# Section 5/6 local MLflow store - superseded inside Docker by the
# separate mlflow service + mlflow_data volume (Dockerfile.mlflow,
# docker-compose.yml). Excluding these also stops a stale local registry
# snapshot from ever being baked into the image.
mlflow.db
mlruns/
mlartifacts/

# Runtime logs - written fresh inside the container (api_logs volume);
# don't ship whatever happens to be in logs/ on the host. predictions.db
# (Section 10) is the same kind of generated-at-runtime file.
logs/*.log
logs/*.db

# Section 10: Prometheus/Grafana configs. Read by the `prometheus`/
# `grafana` containers directly via docker-compose.yml's own volume
# mounts, straight from the repo checkout - never by this image
# (api/register), so they'd just be dead weight here. Keeps "image
# صغير" (Section 8) true for the one thing Section 10 adds.
monitoring/

# Never executed by the service or the image (README: "never executed by
# the service or (later) the image") - large, and irrelevant at runtime.
notebooks/

# The 9 raw Olist CSVs (~124MB, DVC-tracked - see README's "Data &
# artifact versioning"). Notebooks 01-06 read these to produce the
# artifacts this image actually needs (models/*.pkl); nothing under
# src/ or app/ reads data/raw/ itself, so baking it into the image would
# just be 124MB of dead weight - same reasoning as notebooks/ above.
data/raw/

# Test suite / tooling output - requirements-dev.txt only, never
# installed in the image, so these would be dead weight anyway.
tests/
tests_disabled/
htmlcov/
.coverage

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
